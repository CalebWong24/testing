#!/usr/bin/env python
# coding: utf-8

# # Store 20 Sales Data Extraction
# 
# This notebook reads the train.csv file and extracts data for Store 20.

# Import necessary libraries
import pandas as pd

# Read the CSV file
print("Reading train.csv file...")
data = pd.read_csv('train.csv')

print(f"Original data shape: {data.shape}")
print("\nFirst few rows of original data:")
print(data.head())

# Filter data for Store 20
store_20_data = data[data['Store'] == 20]

# Select only the required columns: Store, Dept, and Weekly_Sales
result = store_20_data[['Store', 'Dept', 'Weekly_Sales']]

print(f"\nFiltered data shape (Store 20): {result.shape}")
print("\nFirst few rows of filtered data:")
print(result.head())

# Save the filtered data to a new CSV file
result.to_csv('store_20_sales.csv', index=False)
print("\nFiltered data has been saved to 'store_20_sales.csv'")

# Show some basic statistics
print("\nBasic statistics of Weekly_Sales for Store 20:")
print(result['Weekly_Sales'].describe())

print("\nNumber of unique departments in Store 20:", result['Dept'].nunique())
print("List of departments in Store 20:", sorted(result['Dept'].unique()))
